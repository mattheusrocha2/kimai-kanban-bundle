{% extends 'base.html.twig' %}

{% block page_title %}{{ 'menu.kanban'|trans }}{% endblock %}

{% block main %}
<div class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'kanban.projects.pick'|trans }}</h3>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                {% for project in projects %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{ project.name }}</strong>
                            {% if project.customer %}
                                <small class="text-muted">— {{ project.customer.name }}</small>
                            {% endif %}
                        </div>
                        <div>
                            <a href="{{ path('kanban_project_board', {project: project.id}) }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-columns"></i> {{ 'kanban.view.board'|trans }}
                            </a>
                            <a href="{{ path('kanban_project_list', {project: project.id}) }}" class="btn btn-sm btn-default">
                                <i class="fas fa-list"></i> {{ 'kanban.view.list'|trans }}
                            </a>
                        </div>
                    </li>
                {% else %}
                    <li class="list-group-item">{{ 'kanban.projects.none'|trans }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
